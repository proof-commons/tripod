option(
  'artifact_generation_output_dir',
  type: 'string',
  value: '',
  description: 'Override generate-artifacts output directory for isolated integration tests',
)
option(
  'publication_archive_root',
  type: 'string',
  value: '',
  description: 'Override archive mirror root for isolated publication-repair tests',
)
option(
  'mock_mode',
  type: 'boolean',
  value: false,
  description: 'Mock the TeX toolchain (via execwrap --mock-child) so the Meson graph runs without a TeX toolchain, for the mocked contract test',
)
option(
  'target_native_executor',
  type: 'string',
  value: '',
  description: 'Explicit path to the external Elements executor for the non-default target-elements-native-check target; empty means the native lane is not built and ordinary CI claims no target-native evidence',
)
option(
  'target_native_executor_class',
  type: 'combo',
  choices: ['unselected', 'mock', 'reviewed-non-mock'],
  value: 'unselected',
  description: 'What the caller declares the selected executor to be; the build system makes no such declaration on the caller\'s behalf, so selecting an executor without classifying it fails configuration. A mock declaration can never satisfy the target-native gate',
)
option(
  'target_native_network_id',
  type: 'string',
  value: '',
  description: 'Public development network identifier (64 hex digits) for the target-elements-native-check target',
)
option(
  'target_native_genesis_id',
  type: 'string',
  value: '',
  description: 'Public development genesis identifier (64 hex digits) for the target-elements-native-check target',
)
option(
  'target_native_intended_tip',
  type: 'string',
  value: '',
  description: 'ADR-018: the integration tip the selected executable was built from, as a full 40-digit object identifier. Required when the executor class is reviewed-non-mock',
)
option(
  'target_native_upstream_base',
  type: 'string',
  value: '',
  description: 'ADR-018: the upstream base that tip derives from, as a full 40-digit object identifier. Required when the executor class is reviewed-non-mock',
)
option(
  'target_native_local_topics',
  type: 'array',
  value: [],
  description: 'ADR-018: the local topic branches folded into that tip. An empty census is a statement — a tip that folded in no local branch — rather than an omission',
)
